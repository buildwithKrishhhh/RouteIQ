# RouteIQ Environment Configuration
# Copy this file to .env and fill in your values

# Flask secret key (generate a random one, e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-secret

# MySQL connection
DB_HOST=localhost
DB_USER=routeiq_user
DB_PASSWORD=change-me
DB_NAME=busmg

# Debug mode (set to 1 only in development)
FLASK_DEBUG=0

# Allow LAN access (set to 1 to bind to 0.0.0.0)
ALLOW_LAN=0

# CORS origins (comma-separated, leave empty for same-origin only)
CORS_ORIGINS=

# Retention & Uploads
TRIP_RETENTION_DAYS=90
MAX_CONTENT_LENGTH=16777216
UPLOAD_DIR=uploads
